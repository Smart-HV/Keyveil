APP_NAME=KeyVeil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=keyveil
DB_USERNAME=postgres
DB_PASSWORD=

# Cookie sessions keep only the CSRF token and store no IP / User-Agent server-side.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# SESSION_SECURE_COOKIE=true  # production

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Production: CACHE_STORE=redis (rate limits + scheduler locks).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Branding (name = APP_NAME). Logo/favicon: files inside public/, e.g. /branding/logo.svg.
# Colors and fonts: resources/css/theme.css (docs/theming.md).
BRAND_LOGO=
BRAND_FAVICON=/favicon.svg
BRAND_SHOW_NAME=true

# Comma separated list of trusted reverse proxy IPs/CIDRs (production).
TRUSTED_PROXIES=

# Boost injects a browser logger script in local env; never on secret pages.
BOOST_BROWSER_LOGS_WATCHER=false

SECRET_MIN_TTL_SECONDS=60
SECRET_MAX_TTL_SECONDS=604800
SECRET_MAX_VIEWS=10
SECRET_MAX_ENVELOPE_BYTES=131072

SECRET_CREATE_PER_MINUTE=5
SECRET_CREATE_PER_HOUR=20
SECRET_CLAIM_PER_MINUTE=30
SECRET_DELETE_PER_MINUTE=10
